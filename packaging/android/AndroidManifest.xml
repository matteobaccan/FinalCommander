SPDX-License-Identifier: MIT
(Single dashes: XML forbids two in a row inside a comment.)

The Android app: one activity that starts fcmd with its web terminal and shows the page it
serves on 127.0.0.1 in a web view (packaging/android/README.md). The `fcmd` executable
travels as lib/<abi>/libfcmd.so, extracted at install (extractNativeLibs) into the app's
native library folder, the one place Android lets an app run a file it ships. The
version and the SDK levels are set by build.sh (aapt2 link).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.matteobaccan.finalcommander">

    <!-- The page's socket on 127.0.0.1, and what fcmd connects to: SFTP, FTP, S3. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A file manager sees the phone's files: all of them from Android 11, asked for in
         the system's settings; the two older permissions before that. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- configChanges: a rotation, a keyboard folded out or a new font size keep the
             activity, hence the program it shows. adjustResize: the phone's keyboard
             shrinks the page rather than covering the key bar. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The files fcmd opens with another app, read only, one file at a time to the app
             given the right to it (Files.java). -->
        <provider
            android:name=".Files"
            android:authorities="io.github.matteobaccan.finalcommander.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
