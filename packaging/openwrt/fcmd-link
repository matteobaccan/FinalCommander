#!/bin/sh /etc/rc.common
# FinalCommander Link on an OpenWrt router: a folder (a USB stick, say) offered read only to
# the FinalCommanders of the local network, to callers that give the PIN (SPEC 04 §9.10).
#
#   cp fcmd-link /etc/init.d/ && chmod +x /etc/init.d/fcmd-link
#   edit FCMD, CONFIG and SHARE below
#   fcmd --config /etc/fcmd/fcmd.toml --link-pin        # once: the PIN callers give
#   /etc/init.d/fcmd-link enable && /etc/init.d/fcmd-link start
#   logread -e fcmd                                      # the ID, then a line per call

START=95
STOP=10
USE_PROCD=1

FCMD=/usr/bin/fcmd
CONFIG=/etc/fcmd/fcmd.toml
SHARE=/mnt/usb

start_service() {
	procd_open_instance
	procd_set_param command "$FCMD" --config "$CONFIG" --link-serve "$SHARE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
